# Optional AI provider: Google Gemini (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AWS (optional — only needed for DevOps Agent + Cloud Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# IPInfo (optional — free tier works without a token)
IPINFO_TOKEN=

# Optional docs provider: Context7 (for Code Gen live docs; get key at context7.com/dashboard)
CONTEXT7_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
