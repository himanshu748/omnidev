# AI provider: auto | gemini | ollama
# "auto" (default) uses Gemini when GEMINI_API_KEY is set, otherwise local Ollama.
# Set "ollama" to force fully offline operation.
AI_PROVIDER=auto

# Ollama (local, offline — install from https://ollama.com, then `ollama serve`)
# gemma4:12b covers text, structured output, AND vision in one ~7.6GB model (256K context).
# On lower-memory machines use gemma4:e2b for both.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_VISION_MODEL=gemma4:12b

# Google Gemini (cloud, free — get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AWS (optional — only needed for DevOps Agent + Cloud Storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Context7 (optional — for Code Gen live docs; get key at context7.com/dashboard)
CONTEXT7_API_KEY=

# CORS (only needed if a browser-based client calls the API; the native app talks over loopback)
CORS_ORIGINS=
