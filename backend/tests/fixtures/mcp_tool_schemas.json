  "refine_project": {
    "inputSchema": {
      "$defs": {
        "FileInput": {
          "description": "One project file, as returned by generate_project.",
          "properties": {
            "content": {
              "title": "Content",
              "type": "string"
            },
            "path": {
              "description": "Relative file path, e.g. src/App.tsx",
              "title": "Path",
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "title": "FileInput",
          "type": "object"
        }
      },
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/FileInput"
          },
          "title": "Files",
          "type": "array"
        },
        "framework": {
          "default": "react",
          "title": "Framework",
          "type": "string"
        },
        "instruction": {
          "title": "Instruction",
          "type": "string"
        }
      },
      "required": [
        "files",
        "instruction"
      ],
      "title": "refine_projectArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "refine_projectOutput",
      "type": "object"
    }
  },
